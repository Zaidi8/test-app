NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/prioritree
JWT_ACCESS_SECRET=change_this_to_a_random_32_char_secret
JWT_REFRESH_SECRET=change_this_to_a_random_32_char_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CLIENT_URL=http://localhost:3000

# Google OAuth (optional) — leave blank to disable Google sign-in.
# The /api/v1/auth/google routes return 501 until both ID and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
