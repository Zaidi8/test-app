# PriorTree environment template.
# Copy the relevant section into each app's own env file:
#   • API  → apps/api/.env
#   • Web  → apps/web/.env.local
# Never commit the real .env files (only this .env.example is tracked).

# ─────────────────────────────── API (apps/api) ───────────────────────────────
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/prioritree

# JWT secrets — generate each with:  openssl rand -hex 32   (min 32 chars)
JWT_ACCESS_SECRET=change_this_to_a_random_32_char_secret
JWT_REFRESH_SECRET=change_this_to_a_random_32_char_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Web origin — used for CORS and OAuth redirect target.
CLIENT_URL=http://localhost:3000

# Google OAuth (optional). The /api/v1/auth/google routes return 501 until
# both the client id and secret are set. Create credentials at
# https://console.cloud.google.com → APIs & Services → Credentials, and add
# GOOGLE_CALLBACK_URL as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─────────────────────────────── Web (apps/web) ───────────────────────────────
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Must equal the API's JWT_ACCESS_SECRET — the Next proxy verifies the access
# token server-side. Not prefixed NEXT_PUBLIC_, so it never reaches the browser.
JWT_ACCESS_SECRET=change_this_to_a_random_32_char_secret
